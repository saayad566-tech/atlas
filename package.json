{
  "name": "atlas",
  "version": "1.3.0",
  "private": true,
  "type": "commonjs",
  "description": "Atlas \u2014 a local-first platform for deep fundamental analysis across nine markets",
  "license": "MIT",
  "main": "dist/gateway.js",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx scripts/seed.ts",
    "start": "node dist/gateway.js",
    "dev": "tsx src/gateway.ts",
    "verify:deep": "node scripts/verify-deep.js",
    "verify:ui": "node scripts/verify-ui.js",
    "verify:universe": "node scripts/verify-universe.js",
    "restore": "bash scripts/restore-deps.sh",
    "verify:prod": "node scripts/verify-prod.js",
    "verify:import": "node scripts/verify-import.js",
    "pack": "bash scripts/pack.sh",
    "verify:pwa": "node scripts/verify-pwa.js",
    "verify:zip": "node scripts/verify-zip.js",
    "sign:apk": "bash scripts/sign-apk.sh",
    "audit:hub": "python3 /scratch/skills/module-hub/scripts/audit_hub.py docs/module-hub.json",
    "audit:repo": "python3 /scratch/skills/repo-ci-guardrails/scripts/repo_guard.py secrets --root .",
    "lint:ci": "python3 /scratch/skills/github-actions-ci/scripts/ci_lint.py lint --file .github/workflows/ci.yml",
    "verify:markets": "node scripts/verify-markets.js",
    "verify:all": "bash scripts/verify-all.sh",
    "verify:integrity": "node scripts/verify-integrity.js",
    "verify:quality": "node scripts/verify-quality.js",
    "test": "bash scripts/verify-all.sh",
    "verify:bundles": "node scripts/verify-bundles.js",
    "verify:indexes": "node scripts/verify-universe-sources.js",
    "verify:research": "node scripts/verify-research.js",
    "doctor": "node scripts/doctor.js",
    "report:pdf": "node scripts/report-pdf.js",
    "toolchain": "bash scripts/install-toolchain.sh",
    "build:apk": "bash scripts/build-apk.sh",
    "verify:query": "node scripts/verify-query.js",
    "verify:userfeatures": "node scripts/verify-userfeatures.js",
    "verify:features": "node scripts/verify-features.js",
    "verify:models": "node scripts/verify-models.js",
    "verify:isolation": "node scripts/verify-isolation.js",
    "verify:iso-guard": "node scripts/verify-isolation-static.js",
    "verify:charts": "node scripts/verify-charts.js",
    "verify:indicators": "node scripts/verify-indicators.js",
    "verify:live": "node scripts/verify-live.js",
    "verify:scheduler": "node scripts/verify-scheduler.js",
    "verify:prelisting": "node scripts/verify-prelisting.js",
    "verify:events": "node scripts/verify-events.js",
    "verify:bulk": "node scripts/verify-bulk.js",
    "verify:multimarket": "node scripts/verify-multimarket.js",
    "verify:enrich": "node scripts/verify-enrich.js",
    "verify:apk": "node scripts/verify-apk.js",
    "verify:extras": "node scripts/verify-extras.js",
    "verify:firstrun": "node scripts/verify-firstrun.js",
    "verify:market-switch": "node scripts/verify-market-switch.js",
    "verify:briefing": "node scripts/verify-briefing.js",
    "verify:journal": "node scripts/verify-journal.js",
    "verify:discover": "node scripts/verify-discover.js",
    "verify:provenance": "node scripts/verify-provenance.js",
    "verify:failover": "node scripts/verify-failover.js",
    "verify:valuation-deep": "node scripts/verify-valuation-deep.js",
    "verify:peer-rank": "node scripts/verify-peer-rank.js",
    "verify:history": "node scripts/verify-history.js",
    "verify:backtest": "node scripts/verify-backtest.js",
    "verify:corporate": "node scripts/verify-corporate.js",
    "verify:datatruth": "node scripts/verify-datatruth.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "playwright-core": "^1.49.0",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/atlas/atlas"
  }
}
